@using MostAspNetCore.Models.Route
@model RouteCreateViewModel
@inject IConfiguration Configuration

@{
    ViewData["Title"] = "Create";
    string mapBoxToken = Configuration["MapBoxToken"];
    int productCount = 0;
}

<h1>Create</h1>

<h4>Route</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group mb-1">
                <label asp-for="SelectedDriverId" class="control-label"></label>
                <select asp-for="SelectedDriverId" class="form-control" asp-items="Model.DriversList"></select>
            </div>
            <div class="form-group mb-1">
                <label asp-for="SelectedTransportId" class="control-label"></label>
                <select asp-for="SelectedTransportId" class="form-control" asp-items="Model.TransportsList"></select>
            </div>
            <div class="form-group mb-1">
                <label asp-for="SelectedTrailerId" class="control-label"></label>
                <select asp-for="SelectedTrailerId" class="form-control" asp-items="Model.TrailersList"></select>
            </div>
            <div class="form-group mb-1">
                <label asp-for="SelectedStartBuildingId" class="control-label"></label>
                <select asp-for="SelectedStartBuildingId" class="form-control" asp-items="Model.BuildingsList" onchange="optionChange()"></select>
                <span asp-validation-for="SelectedStartBuildingId" class="text-danger"></span>
            </div>
            <div class="form-group mb-3">
                <label asp-for="SelectedEndBuildingId" class="control-label"></label>
                <select asp-for="SelectedEndBuildingId" class="form-control" asp-items="Model.BuildingsList" onchange="optionChange()"></select>
                <span asp-validation-for="SelectedEndBuildingId" class="text-danger"></span>
            </div>
            <div class="row">
                <div class="form-group col-md-3">
                    <input type="submit" value="Создать" class="btn btn-primary" />
                </div>
                <div class="col-md-5">
                    <a asp-action="index" type="button" class="btn btn-secondary">Назад к списку</a>
                </div>
            </div>
            
        </form>
    </div>
    <div class="col-md-8">
        <div style="height:400px; border: 1px solid black;" id="map"></div>
    </div>
</div>



<h2>Грузы</h2>
<ul class="nav nav-tabs" id="myTab" role="tablist">
    @for (int i = 0; i < Model.CargosList.Count; i++)
    {
        <li class="nav-item" role="presentation">
            <button class="nav-link active" id="@i-cargo-tab" data-bs-toggle="tab" data-bs-target="#@i-cargo" type="button" role="tab" aria-controls="profile" aria-selected="false">@Model.CargosList[i].DestinationBuilding.BuildingName</button>
        </li>
    }
</ul>


    <div class="tab-content" id="myTabContent">
    @for (int i = 0; i < Model.CargosList.Count; i++)
    {
        <div class="tab-pane active" id="@i-cargo" role="tabpanel" aria-labelledby="@i-cargo-tab">
            <table class="table">
                <thead>
                    <tr>
                        <th scope="col">#</th>
                        <th scope="col">Название</th>
                        <th scope="col">Тип упаковки</th>
                        <th scope="col">Категория</th>
                        <th scope="col">Хрупкий</th>
                        <th scope="col">Необходим рефрижератор</th>
                        <th scope="col">Длина</th>
                        <th scope="col">Ширина</th>
                        <th scope="col">Высота</th>
                        <th scope="col">Количество</th>
                    </tr>
                </thead>
                <tbody>
                    @for (int j = 1; j < Model.CargosList[i].ProductsList.Count + 1; j++)
                    {
                        <tr>
                            <th scope="row">@j</th>
                            <td>@Model.CargosList[i].ProductsList[j - 1].ProductName</td>
                            <td>@Model.CargosList[i].ProductsList[j - 1].ProductPackageTypeId</td>
                            <td>@Model.CargosList[i].ProductsList[j - 1].ProductCategoryId</td>
                            <td>@Model.CargosList[i].ProductsList[j - 1].IsFragile</td>
                            <td>@Model.CargosList[i].ProductsList[j - 1].NeedsRefrigerator</td>
                            <td>@Model.CargosList[i].ProductsList[j - 1].Length</td>
                            <td>@Model.CargosList[i].ProductsList[j - 1].Width</td>
                            <td>@Model.CargosList[i].ProductsList[j - 1].Height</td>
                            <td>@Model.CargosList[i].ProductsList[j - 1].Quantity</td>
                        </tr>
                    }
                    
                </tbody>
            </table>
        </div>
    }
    </div>

<!--MapBox-->
<script>
    mapboxgl.accessToken = '@mapBoxToken';

    var startOptions;  
    var startCoordinates;
    var endOptions;
    var endCoordinates;
    var middleCoordinates;

    function changeCoordinates() {
        startOptions = document.getElementById('SelectedStartBuildingId').options;  //Получаем options из SelectedStartBuildingId
        startCoordinates = startOptions[startOptions.selectedIndex].text.split(" - ")[2].split(","); //Получаем массив двух координат из выбранной option разделяя текст по " - " и разделяя координаты по "," 
        endOptions = document.getElementById('SelectedEndBuildingId').options;  //Все тоже самое только для SelectedEndBuildingId
        endCoordinates = endOptions[endOptions.selectedIndex].text.split(" - ")[2].split(",");
        middleCoordinates = [  //вычисляем середину между двумя координатами
            (Number(startCoordinates[0]) + Number(endCoordinates[0])) / 2,
            (Number(startCoordinates[1]) + Number(endCoordinates[1])) / 2,
        ]
    }
    
    changeCoordinates(); //вызываем функцию чтобы определить 
    const map = new mapboxgl.Map({
        container: 'map',
        style: 'mapbox://styles/mapbox/streets-v12',
        center: middleCoordinates, // starting position
        zoom: 12
    });


    // create a function to make a directions request
    async function getRoute(end) {
        // make a directions request using cycling profile
        // an arbitrary start will always be the same
        // only the end or destination will change
        const query = await fetch(
            `https://api.mapbox.com/directions/v5/mapbox/cycling/${startCoordinates[0]},${startCoordinates[1]};${endCoordinates[0]},${endCoordinates[1]}?steps=true&geometries=geojson&access_token=${mapboxgl.accessToken}`,
            { method: 'GET' }
        );
        const json = await query.json();
        const data = json.routes[0];
        const route = data.geometry.coordinates;
        const geojson = {
            type: 'Feature',
            properties: {},
            geometry: {
                type: 'LineString',
                coordinates: route
            }
        };
        // if the route already exists on the map, we'll reset it using setData
        if (map.getSource('route')) {
            map.getSource('route').setData(geojson);
        }
        // otherwise, we'll make a new request
        else {
            map.addLayer({
                id: 'route',
                type: 'line',
                source: {
                    type: 'geojson',
                    data: geojson
                },
                layout: {
                    'line-join': 'round',
                    'line-cap': 'round'
                },
                paint: {
                    'line-color': '#3887be',
                    'line-width': 5,
                    'line-opacity': 0.75
                }
            });
        }
        // add turn instructions here at the end
    }

    map.on('load', () => {
        // make an initial directions request that
        // starts and ends at the same location
        changeCoordinates();
        getRoute();
        optionChange();
    });
    map.loadImage('/icons/BlueMarker.png', (error, image) => {
        if (error) throw error;
        map.addImage('BlueMarker', image);
    }); 
    map.loadImage('/icons/RedMarker.png', (error, image) => {
        if (error) throw error;
        map.addImage('RedMarker', image);
    });

    function optionChange() {
        changeCoordinates();
        const end = {
            type: 'FeatureCollection',
            features: [
                {
                    type: 'Feature',
                    properties: {},
                    geometry: {
                        type: 'Point',
                        coordinates: endCoordinates
                    }
                }
            ]
        };
        if (map.getLayer('end')) {
            map.getSource('end').setData(end);
        } else {
            map.addLayer({
                id: 'end',
                type: 'symbol',
                source: {
                    type: 'geojson',
                    data: {
                        type: 'FeatureCollection',
                        features: [
                            {
                                type: 'Feature',
                                properties: {},
                                geometry: {
                                    type: 'Point',
                                    coordinates: endCoordinates
                                }
                            }
                        ]
                    }
                },
                layout: {
                    'icon-image': 'RedMarker', // Use a custom icon image
                    'icon-size': 0.1,
                }
            });
        }
        const start = {
            type: 'FeatureCollection',
            features: [
                {
                    type: 'Feature',
                    properties: {},
                    geometry: {
                        type: 'Point',
                        coordinates: startCoordinates
                    }
                }
            ]
        };
        if (map.getLayer('start')) {
            map.getSource('start').setData(start);
        } else {
            map.addLayer({
                id: 'start',
                type: 'symbol',
                source: {
                    type: 'geojson',
                    data: {
                        type: 'FeatureCollection',
                        features: [
                            {
                                type: 'Feature',
                                properties: {},
                                geometry: {
                                    type: 'Point',
                                    coordinates: startCoordinates
                                }
                            }
                        ]
                    }
                },
                layout: {
                    'icon-image': 'BlueMarker', // Use a custom icon image
                    'icon-size' : 0.1,
                }
            });
        }
        getRoute();
    };



















