@using MostLib.Enums
@using Microsoft.Extensions.Configuration
@inject IConfiguration Configuration
@model MostLib.Building

@{
    ViewData["Title"] = "Редактирование здания";
    string mapBoxToken = Configuration["MapBoxToken"];
}

<h1>Редактирование здания</h1>

<hr />
<div class="row">
    <div class="col-md-3">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input asp-for="BuildingId" class="form-control" hidden />
            <div class="form-group mb-1">
                <label asp-for="Address" class="control-label"></label>
                <textarea asp-for="Address" rows="3" class="form-control" id="inputAddress" readonly> </textarea>
                <span asp-validation-for="Address" class="text-danger"></span>
            </div>
            <div class="form-group mb-1">
                <label asp-for="Coordinates" class="control-label"></label>
                <input asp-for="Coordinates" class="form-control" id="inputCoordinates" readonly />
                <span asp-validation-for="Coordinates" class="text-danger"></span>
            </div>
            <div class="form-group mb-1">
                <label asp-for="BuildingName" class="control-label"></label>
                <input asp-for="BuildingName" class="form-control" />
                <span asp-validation-for="BuildingName" class="text-danger"></span>
            </div>
            <div class="form-group mb-1">
                <label asp-for="BuildingTypeId" class="control-label"></label>
                <select asp-for="BuildingTypeId" class="form-control">
                    <option value="0">Магазин</option>
                    <option value="1">Склад</option>
                </select>
                <span asp-validation-for="BuildingTypeId" class="text-danger"></span>
            </div>
            <div class="form-group mb-3">
                <label asp-for="Comment" class="control-label"></label>
                <textarea asp-for="Comment" class="form-control"></textarea>
                <span asp-validation-for="Comment" class="text-danger"></span>
            </div>
            <div class="form-group mb-1">
                <input type="submit" value="Изменить" class="btn btn-primary" />
            </div>
        </form>
    </div>
    <div class="col-md-9">
        <div style="height:400px; border: 1px solid black;" id="map"></div>
    </div>

</div>

<div>
    <a class="text-decoration-none" asp-action="Index">Назад к списку</a>
</div>

<!--MapBox-->
<script>
    mapboxgl.accessToken = '@mapBoxToken';
    var mycoordinates = document.getElementById('inputCoordinates').value.split(",");
    var latitude = mycoordinates[0];
    var longitude = mycoordinates[1];
    const map = new mapboxgl.Map({
        container: 'map',
        style: 'mapbox://styles/mapbox/streets-v12',
        center: [latitude, longitude],
        zoom: 14
    });

    const geocoder = new MapboxGeocoder({
        accessToken: mapboxgl.accessToken,
        mapboxgl: mapboxgl,
        reverseGeocode: true
    });

    map.on('load', () => { 
        var popup = new mapboxgl.Popup({ offset: 25 }) //Создаем popup
            .setText(document.getElementById('inputAddress').value);

        const marker = new mapboxgl.Marker({ color: '#314ccd' }) // Добавляем маркер с нужным цветом
        .setLngLat([latitude, longitude])       // Задаем коорлдинаты
        .setPopup(popup)        //Добавляем созданный popup
        .addTo(map);        // И добавляем на карту
    });







</script>
<!--/MapBox-->
@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
