@model MostLib.Building

@{
    ViewData["Title"] = "Удаление здания";
}

<h1>Удаление здания</h1>

<h3>Вы уверены что хотите удалить это здание?</h3>
<div>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Address)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Address)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Coordinates)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Coordinates)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.BuildingName)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.BuildingName)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.BuildingTypeId)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.BuildingTypeId)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Comment)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Comment)
        </dd>
    </dl>
    
    <form asp-action="Delete">
        <input type="hidden" asp-for="BuildingId" />
        <input type="submit" value="Удалить" class="btn btn-danger" /> |
        <a class="text-decoration-none" asp-action="Index">Назад к спсику</a>
    </form>
</div>
