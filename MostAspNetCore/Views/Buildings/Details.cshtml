                    <th scope="col">Handle</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <th scope="row">1</th>
                    <td>Mark</td>
                    <td>Otto</td>
                    <td></td>
                </tr>
                <tr>
                    <th scope="row">2</th>
                    <td>Jacob</td>
                    <td>Thornton</td>
                    <td></td>
                </tr>
                <tr>
                    <th scope="row">3</th>
                    <td colspan="2">Larry the Bird</td>
                    <td></td>
                </tr>
            </tbody>
        </table>
    </div>
    <div class="tab-pane fade show active" id="start" role="tabpanel" aria-labelledby="start-tab">
        <table class="table">
            <thead>
                <tr>
                    <th scope="col">#</th>
                    <th scope="col">Start!</th>
                    <th scope="col">Last</th>
                    <th scope="col">Handle</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <th scope="row">1</th>
                    <td>Mark</td>
                    <td>Otto</td>
                    <td></td>
                </tr>
                <tr>
                    <th scope="row">2</th>
                    <td>Jacob</td>
                    <td>Thornton</td>
                    <td></td>
                </tr>
                <tr>
                    <th scope="row">3</th>
                    <td colspan="2">Larry the Bird</td>
                    <td></td>
                </tr>
            </tbody>
        </table>
    </div>
    <div class="tab-pane fade" id="end" role="tabpanel" aria-labelledby="end-tab">
        <table class="table">
            <thead>
                <tr>
                    <th scope="col">#</th>
                    <th scope="col">End</th>
                    <th scope="col">Last</th>
                    <th scope="col">Handle</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <th scope="row">1</th>
                    <td>Mark</td>
                    <td>Otto</td>
                    <td></td>
                </tr>
                <tr>
                    <th scope="row">2</th>
                    <td>Jacob</td>
                    <td>Thornton</td>
                    <td></td>
                </tr>
                <tr>
                    <th scope="row">3</th>
                    <td colspan="2">Larry the Bird</td>
                    <td></td>
                </tr>
            </tbody>
        </table>
    </div>
</div>


<div>
    <a class="text-decoration-none" asp-action="Index">Назад к списку</a>
</div>

<!--MapBox-->
<script>
    mapboxgl.accessToken = '@mapBoxToken';
    var mycoordinates = document.getElementById('inputCoordinates').value.split(",");
    var latitude = mycoordinates[0];
    var longitude = mycoordinates[1];
    const map = new mapboxgl.Map({
        container: 'map',
        style: 'mapbox://styles/mapbox/streets-v12',
        center: [latitude, longitude],
        zoom: 14
    });

    const geocoder = new MapboxGeocoder({
        accessToken: mapboxgl.accessToken,
        mapboxgl: mapboxgl,
        reverseGeocode: true
    });

    map.on('load', () => {
        var popup = new mapboxgl.Popup({ offset: 25 }) //Создаем popup
            .setText(document.getElementById('inputAddress').value);

        const marker = new mapboxgl.Marker({ color: '#314ccd' }) // Добавляем маркер с нужным цветом
            .setLngLat([latitude, longitude])       // Задаем коорлдинаты
            .setPopup(popup)        //Добавляем созданный popup
            .addTo(map);        // И добавляем на карту
    });

</script>
<!--/MapBox-->
@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
