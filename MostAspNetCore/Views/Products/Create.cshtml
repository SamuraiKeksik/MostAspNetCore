@model MostLib.Product
@using MostLib.Enums;
@using System.ComponentModel.DataAnnotations
@using System.Reflection

@{
    ViewData["Title"] = "Добавление товара";
    int productPackageTypeCount = 0;
    int productCategoryCount = 0;
}

<h1>Добавление товара</h1>

<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="ProductName" class="control-label"></label>
                <input asp-for="ProductName" class="form-control" />
                <span asp-validation-for="ProductName" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="ProductPackageTypeId" class="control-label"></label>
                <select asp-for="ProductPackageTypeId" class="form-control">
                    @foreach (var type in Enum.GetValues(typeof(ProductPackageType)))
                    {
                        var memberInfo = typeof(ProductPackageType).GetMember(type.ToString()).First();
                        var displayAttribute = memberInfo.GetCustomAttribute<DisplayAttribute>();
                        var displayName = displayAttribute != null ? displayAttribute.Name : type.ToString();

                        <option value="@productPackageTypeCount">@displayName</option>
                        productPackageTypeCount++;
                    }
                </select>
                <span asp-validation-for="ProductPackageTypeId" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="ProductCategoryId" class="control-label"></label>
                <select asp-for="ProductCategoryId" class="form-control">
                    @foreach (var type in Enum.GetValues(typeof(ProductCategory)))
                    {
                        var memberInfo = typeof(ProductCategory).GetMember(type.ToString()).First();
                        var displayAttribute = memberInfo.GetCustomAttribute<DisplayAttribute>();
                        var displayName = displayAttribute != null ? displayAttribute.Name : type.ToString();

                        <option value="@productCategoryCount">@displayName</option>
                        productCategoryCount++;
                    }
                </select>
                <span asp-validation-for="ProductCategoryId" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Brand" class="control-label"></label>
                <input asp-for="Brand" class="form-control" />
                <span asp-validation-for="Brand" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Description" class="control-label"></label>
                <input asp-for="Description" class="form-control" />
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="ArticleNumber" class="control-label"></label>
                <input asp-for="ArticleNumber" class="form-control" />
                <span asp-validation-for="ArticleNumber" class="text-danger"></span>
            </div>
            <div class="form-group form-check">
                <label class="form-check-label">
                    <input class="form-check-input" asp-for="IsFragile" /> @Html.DisplayNameFor(model => model.IsFragile)
                </label>
            </div>
            <div class="form-group form-check">
                <label class="form-check-label">
                    <input class="form-check-input" asp-for="NeedsRefrigerator" /> @Html.DisplayNameFor(model => model.NeedsRefrigerator)
                </label>
            </div>
            <div class="form-group">
                <label asp-for="Length" class="control-label"></label>
                <input asp-for="Length" class="form-control" />
                <span asp-validation-for="Length" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Width" class="control-label"></label>
                <input asp-for="Width" class="form-control" />
                <span asp-validation-for="Width" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Height" class="control-label"></label>
                <input asp-for="Height" class="form-control" />
                <span asp-validation-for="Height" class="text-danger"></span>
            </div>
            <div class="form-group mb-3">
                <label asp-for="Radius" class="control-label"></label>
                <input asp-for="Radius" class="form-control" />
                <span asp-validation-for="Radius" class="text-danger"></span>
            </div>
            <div class="form-group mb-1">
                <input type="submit" value="Добавить" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a class="text-decoration-none" asp-action="Index">Назад к списку</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
